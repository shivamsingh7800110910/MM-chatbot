<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#312e81" />
      <stop offset="50%" stop-color="#4c1d95" />
      <stop offset="100%" stop-color="#831843" />
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="100%" height="100%" fill="url(#grad)" />
  <circle cx="512" cy="472" r="120" fill="none" stroke="#6366f1" stroke-width="4" opacity="0.6" filter="url(#glow)"/>
  <circle cx="512" cy="472" r="70" fill="#a855f7" opacity="0.3" filter="url(#glow)"/>
  <text x="512" y="482" font-family="sans-serif" font-size="48" fill="#ffffff" text-anchor="middle">✨</text>
  <text x="512" y="592" font-family="sans-serif" font-size="22" font-weight="bold" fill="#ffffff" text-anchor="middle">AI Generated Artwork</text>
  <text x="512" y="627" font-family="sans-serif" font-size="14" fill="#cbd5e1" text-anchor="middle">"A futuristic glowing neon city skyline at twilight"</text>
  <text x="512" y="657" font-family="sans-serif" font-size="12" fill="#94a3b8" text-anchor="middle">Style: Cyberpunk • Ratio: 1024x1024</text>
</svg>