# Multimodal AI Chatbot Environment Configuration

# Project & App Settings
PROJECT_NAME="Multimodal AI Chatbot"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api"

# Database Configuration (PostgreSQL with pgvector, fallback to SQLite if PostgreSQL is unavailable)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multimodal_chatbot"
# For SQLite standalone testing, you can use:
# DATABASE_URL="sqlite:///./chatbot.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# CORS (Frontend origins)
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'

# LLM Providers Configuration
# Supported providers: "gemini", "openai", "mock"
DEFAULT_LLM_PROVIDER="gemini"

# Google Gemini Configuration
# Get your API key at: https://aistudio.google.com
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# OpenAI Configuration (Optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Web Search Provider Configuration
# Supported: "duckduckgo", "tavily", "mock"
SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""

# Audio Processing
AUDIO_TTS_PROVIDER="gtts" # "gtts" or "gemini"
AUDIO_STT_PROVIDER="gemini" # "gemini" or "browser"
